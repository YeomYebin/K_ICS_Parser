# 이 파일을 .env 로 복사한 뒤 값을 채우세요. (.env 는 커밋되지 않음)

# ── Bedrock 인증 ──────────────────────────────────────────────
# 로컬 PC 실행: Bedrock API 키(베어러 토큰)를 넣으세요.
# EC2 실행: IAM 인스턴스 역할을 쓰면 이 줄을 아예 비우거나 지우세요(키 불필요).
AWS_BEARER_TOKEN_BEDROCK=OOO

# Bedrock 리전 (예: us-east-1, us-west-2, ap-northeast-2)
AWS_REGION=us-east-1

# 사용할 모델 ID (리전 프리픽스가 붙은 '추론 프로파일 ID' 사용).
BEDROCK_MODEL_ID=us.anthropic.claude-opus-4-6-v1

# ── 웹 접속 보호 ──────────────────────────────────────────────
# 접속 비밀번호. 설정하면 로그인 페이지가 뜹니다(아이디 없이 비밀번호만).
# 비워두면 누구나 접속 가능(보호 안 함). 공개 배포 시 반드시 설정하세요.
#   예) APP_PASSWORD=kics2026
APP_PASSWORD=OOO

# 세션 서명 키. 아무 긴 랜덤 문자열. (예: python -c "import secrets;print(secrets.token_hex(32))")
# 비워두면 서버 재시작 때마다 재로그인이 필요합니다.
SECRET_KEY=OOO
