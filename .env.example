# Bedrock 인증 (Bedrock API 키 방식)
# 아래 OOO 값을 실제 값으로 채운 뒤 이 파일을 .env 로 복사하세요.

# Bedrock API 키 (단일 베어러 토큰) — boto3가 자동으로 인식합니다.
AWS_BEARER_TOKEN_BEDROCK=OOO

# Bedrock 리전 (예: us-east-1, us-west-2, ap-northeast-2)
AWS_REGION=us-east-1

# 사용할 모델 ID (리전 프리픽스가 붙은 '추론 프로파일 ID' 사용).
# 주의: 목록에 'ACTIVE' 로 보여도 계정에 모델 접근권한(entitlement)이 없으면
#       AccessDenied 가 납니다. 아래는 이 계정에서 '실제 호출 성공' 확인된 모델:
#   권장) us.anthropic.claude-opus-4-6-v1          ← Opus 계열, 비전 OCR 동작 확인
#   대안) us.anthropic.claude-sonnet-4-6 / us.anthropic.claude-sonnet-4-5-20250929-v1:0
#         us.anthropic.claude-haiku-4-5-20251001-v1:0
#   ❌ Opus 4.7/4.8/5, Sonnet 5 는 이 계정 접근권한 없음
#      (필요 시 AWS 콘솔 > Amazon Bedrock > Model access 에서 접근 신청)
#   호출 가능한 ID 확인: `python list_bedrock_models.py`
#   실제 호출 성공 여부까지 확인하려면 각 모델로 converse 테스트 필요
BEDROCK_MODEL_ID=us.anthropic.claude-opus-4-6-v1
